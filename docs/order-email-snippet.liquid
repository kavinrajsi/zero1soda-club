{%- comment -%}
  Club Zero1 event tickets — one QR per ticket.

  WHERE TO PASTE
  In Shopify admin → Settings → Notifications → Order confirmation → Edit code,
  find this block near the end of the template:

      <table class="row section">
        <tr>
          <td class="section__cell">
            <center>
              <table class="container">
                <tr>
                  <td>
                    <h3>Customer information</h3>

  Paste this whole file on the line ABOVE that `<table class="row section">`,
  i.e. after the Order summary section closes and before Customer information.
  Tickets then sit under the order summary, above the address block.

  HOW IT DECIDES WHAT IS A TICKET
  Line items booked through club.zero1soda.com carry an `Event` property, set by
  /api/checkout. That is the test used here — more reliable than product type,
  and it also gives the venue and city without extra lookups.

  order.metafields.club.ticket_key is written by the orders/create webhook
  (/api/webhooks/orders). While it is blank this block renders nothing, which
  also means no tickets went out — check the webhook before the template.
{%- endcomment -%}

{%- assign club_url = 'https://club.zero1soda.com' -%}
{%- assign ticket_key = order.metafields.club.ticket_key -%}

{%- if ticket_key -%}
  {%- assign has_tickets = false -%}
  {%- for line in line_items -%}
    {%- if line.properties['Event'] != blank -%}
      {%- assign has_tickets = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_tickets -%}
    <table class="row section">
      <tr>
        <td class="section__cell">
          <center>
            <table class="container">
              <tr>
                <td>
                  <h3>Your tickets</h3>
                </td>
              </tr>
            </table>

            <table class="container">
              <tr>
                <td>
                  {%- for line in line_items -%}
                    {%- if line.properties['Event'] != blank -%}
                      <table class="row">
                        <tr>
                          <td style="padding:14px 0 0;font-family:Helvetica,Arial,sans-serif;">
                            <span style="font-size:16px;font-weight:600;color:#1c1212;">
                              {{ line.properties['Event'] }}
                            </span>
                            <br />
                            <span style="font-size:13px;color:#6c6360;">
                              {{ line.properties['Venue'] }}{% if line.properties['City'] != blank %} · {{ line.properties['City'] }}{% endif %}
                            </span>
                          </td>
                        </tr>

                        {%- for i in (1..line.quantity) -%}
                          <tr>
                            <td align="center" style="padding:18px 0;font-family:Helvetica,Arial,sans-serif;">
                              <img
                                src="{{ club_url }}/api/ticket/qr?o={{ order.id }}&amp;l={{ line.id }}&amp;n={{ i }}&amp;t={{ line.quantity }}&amp;k={{ ticket_key }}&amp;size=240"
                                width="200"
                                height="200"
                                alt="Ticket {{ i }} of {{ line.quantity }}"
                                style="display:block;border:0;border-radius:10px;"
                              />
                              <p style="margin:10px 0 0;font-size:13px;font-weight:600;color:#1c1212;">
                                Ticket {{ i }} of {{ line.quantity }}
                              </p>
                              <p style="margin:4px 0 0;font-size:12px;">
                                <a href="{{ club_url }}/ticket/view?o={{ order.id }}&amp;l={{ line.id }}&amp;n={{ i }}&amp;t={{ line.quantity }}&amp;k={{ ticket_key }}">View this ticket</a>
                              </p>
                            </td>
                          </tr>
                        {%- endfor -%}
                      </table>
                    {%- endif -%}
                  {%- endfor -%}

                  <p style="font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#6c6360;margin:6px 0 0;">
                    Show each code at the door. Every ticket is scanned once.
                  </p>
                </td>
              </tr>
            </table>
          </center>
        </td>
      </tr>
    </table>
  {%- endif -%}
{%- endif -%}
