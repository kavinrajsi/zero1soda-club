# Shopify store that owns the products and runs checkout.
# Use the *.myshopify.com domain, not the custom domain.
SHOPIFY_STORE_DOMAIN=zero1soda.myshopify.com

# --- Storefront API (required) ------------------------------------------------
# From the Headless sales channel: Shopify admin → Headless → your storefront.
# Set the private token (server-side only, what this app uses) or, failing that,
# the public one. Private wins if both are set.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=

# --- Admin API (optional: only the "Register your interest" form) -------------
# Dev Dashboard app credentials. The app exchanges these for a 24h token itself.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Legacy alternative: a static token from an admin-created custom app.
# Shopify stopped allowing new ones on 1 Jan 2026; existing ones still work.
SHOPIFY_ADMIN_TOKEN=

# --- Ticket QR check-in (optional feature) ------------------------------------
# 32+ random chars; signs ticket tokens. Rotating it invalidates issued QR codes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TICKET_SECRET=
# Passcode door staff type once per device to unlock /checkin.
CHECKIN_PASSCODE=
# Defaults to SHOPIFY_APP_CLIENT_SECRET, which is what signs this app's webhooks.
SHOPIFY_WEBHOOK_SECRET=
# Where Shopify posts orders/create. Must NOT be a domain attached to the store
# (club.zero1soda.com is rejected), so use the project's vercel.app alias.
WEBHOOK_CALLBACK_BASE=https://zero1soda-club-sigma.vercel.app

# --- Staff modules: admin dashboard and door checker --------------------------
# Numeric shop id, from the Customer Account API card in the Headless channel.
SHOPIFY_SHOP_ID=
# Client ID from Headless → Customer Account API → Manage.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Signs the staff session cookie. Falls back to TICKET_SECRET when unset.
SESSION_SECRET=

# Optional overrides.
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_EVENT_PRODUCT_TYPE=Event ticket

NEXT_PUBLIC_SITE_URL=https://club.zero1soda.com
NEXT_PUBLIC_STORE_URL=https://www.zero1soda.com
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/C1pghxGXy76AoYbMByMZK8?mode=gi_t
NEXT_PUBLIC_NOTIFY_CITIES=Bengaluru,Chennai,Coimbatore
