# Shopify store that owns the products and runs checkout.
# Use the *.myshopify.com domain, not the custom domain.
SHOPIFY_STORE_DOMAIN=zero1soda.myshopify.com

# Storefront API access token (Admin → Settings → Apps and sales channels →
# Develop apps → your app → Storefront API). Needs unauthenticated_read_product_listings
# and unauthenticated_write_checkouts.
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Only needed for the "Register your interest" form, which writes a
# tagged customer. Needs read_customers + write_customers.
SHOPIFY_ADMIN_TOKEN=

# Optional overrides.
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_EVENT_PRODUCT_TYPE=Event ticket

NEXT_PUBLIC_SITE_URL=https://club.zero1soda.com
NEXT_PUBLIC_STORE_URL=https://www.zero1soda.com
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/C1pghxGXy76AoYbMByMZK8?mode=gi_t
NEXT_PUBLIC_NOTIFY_CITIES=Bengaluru,Chennai,Coimbatore
